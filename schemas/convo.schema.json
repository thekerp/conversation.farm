{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://conversation.farm/schemas/convo.schema.json",
  "title": "convo/1",
  "type": "object",
  "required": ["schema", "id", "farm", "number", "slug", "title", "state", "participants", "beats"],
  "additionalProperties": false,
  "properties": {
    "schema": { "const": "convo/1" },
    "id": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
    "farm": { "type": "string" },
    "number": { "type": "integer", "minimum": 1 },
    "slug": { "type": "string" },
    "title": { "type": "string" },
    "hook": { "type": "string", "maxLength": 220 },
    "state": {
      "enum": ["recorded","transcribed","segmented","researched","reviewed","published","composted"]
    },
    "recorded": { "type": "string", "format": "date" },
    "published": { "type": ["string","null"], "format": "date" },
    "runtime_seconds": { "type": "integer" },
    "style": { "type": "string", "description": "Visual style for this convo. One per convo." },
    "participants": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "required": ["person","role"],
        "properties": {
          "person": { "type": "string" },
          "role": { "enum": ["host","guest"] }
        }
      }
    },
    "media": {
      "type": "object",
      "properties": {
        "audio_url": { "type": "string", "format": "uri" },
        "tracks_dir": { "type": "string" },
        "transcript": { "type": "string" },
        "clips_dir": { "type": "string" },
        "images_dir": { "type": "string" }
      }
    },
    "beats": {
      "type": "array", "minItems": 5, "maxItems": 9,
      "items": {
        "type": "object",
        "required": ["id","t","speaker","speaker_confidence","claim"],
        "properties": {
          "id": { "type": "string" },
          "t": { "type": "number" },
          "t_end": { "type": "number" },
          "speaker": { "type": "string" },
          "speaker_confidence": { "enum": ["confirmed","inferred"] },
          "claim": { "type": "string", "maxLength": 300 },
          "context": { "type": "string" },
          "clip": { "type": "string" },
          "image": { "type": "string" },
          "tendrils": { "type": "array", "maxItems": 3, "items": { "type": "string" } },
          "checks": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "tendrils": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id","beat","kind","title","url","why","retrieved","http_status"],
        "properties": {
          "id": { "type": "string" },
          "beat": { "type": "string" },
          "kind": { "enum": ["paper","article","video","person","tool","prior_episode","book"] },
          "title": { "type": "string" },
          "url": { "type": "string", "format": "uri" },
          "source": { "type": "string" },
          "why": { "type": "string", "maxLength": 200 },
          "retrieved": { "type": "string", "format": "date" },
          "http_status": { "const": 200 }
        }
      }
    },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id","beat","verdict","claim_as_said","what_we_found","sources","confidence"],
        "properties": {
          "id": { "type": "string" },
          "beat": { "type": "string" },
          "verdict": { "enum": ["confirmed","off","wrong","contested","unverified","outdated"] },
          "claim_as_said": { "type": "string" },
          "what_we_found": { "type": "string" },
          "sources": { "type": "array", "minItems": 1, "items": { "type": "string" } },
          "confidence": { "enum": ["high","medium","low"] },
          "host_note": { "type": ["string","null"] }
        }
      }
    },
    "seeds": {
      "type": "array", "maxItems": 3,
      "items": {
        "type": "object", "required": ["id","question"],
        "properties": {
          "id": { "type": "string" },
          "from_beat": { "type": "string" },
          "question": { "type": "string" }
        }
      }
    },
    "compost": {
      "type": "array",
      "items": {
        "type": "object", "required": ["convo","relation"],
        "properties": {
          "convo": { "type": "string" },
          "beat": { "type": "string" },
          "relation": { "enum": ["contradicts","extends","repeats","answers"] },
          "note": { "type": "string" }
        }
      }
    },
    "provenance": {
      "type": "object",
      "required": ["transcriber","diarization","generated"],
      "properties": {
        "transcriber": { "type": "string" },
        "diarization": { "type": "string" },
        "research_pass": { "type": "string" },
        "image_model": { "type": "string" },
        "human_review": { "type": "array", "items": { "type": "string" } },
        "cost_usd": { "type": "number" },
        "generated": { "type": "string", "format": "date-time" }
      }
    }
  }
}
